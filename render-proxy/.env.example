# DraftApply Render proxy
# Copy to `.env` for local proxy development. Do not commit real secrets.

TOKEN_SECRET=replace-with-a-long-random-string

# Production safety. Internal structured CV generation is unaffected.
ALLOW_LEGACY_RAW_PROMPTS=false
REQUEST_DEADLINE_MS=90000
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_MS=30000
REDIS_URL=
# Production with paid provider keys refuses startup without Redis. Set false
# explicitly only for local/single-process development.
REQUIRE_DURABLE_QUOTAS=true
# Per-install daily quotas (24h UTC window). Requests are coarse: answer
# prefetch on field focus also consumes one. Tokens/spend are reserved at a
# conservative worst-case estimate per request and reconciled to actual
# provider usage afterwards; spend is in micro-dollars (5000000 = $5/day).
# A denial returns code quota_subject_requests|tokens|spend etc. in the 429
# body and the server log, naming the cap that fired.
# QUOTA_MAX_REQUESTS_PER_SUBJECT=100
# QUOTA_MAX_TOKENS_PER_SUBJECT=5000000
# QUOTA_MAX_SPEND_MICROS_PER_SUBJECT=5000000

# Hosted primary path. Recommended for production final answers/CV generation.
GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Hosted fallback path. Used when Groq is busy/rate-limited and a fallback is allowed.
OPENROUTER_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
OPENROUTER_MAX_FALLBACK_MODELS=6
OPENROUTER_TAILOR_FALLBACK=true
OPENROUTER_USE_MODELS_ARRAY=false
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_SITE_URL=https://draftapply.com
OPENROUTER_APP_NAME=DraftApply

# Optional lightweight model router.
# Point this at an OpenAI-compatible inference server such as vLLM, LM Studio,
# Ollama's OpenAI-compatible endpoint, or a managed endpoint.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Keep false at first: local Qwen is used for lower-risk extraction/enrichment
# steps, while final user-visible generation stays on hosted Groq/OpenRouter.
LOCAL_LLM_PREFER_FOR_GENERATION=false

# Optional evidence retrieval/reranking endpoint. Deterministic matching
# remains the fallback whenever this is unset or a call fails/times out.
# mxbai-embed-large-v1 was live-benchmarked via Hugging Face's free
# hf-inference route (https://router.huggingface.co/hf-inference) and beat
# deterministic keyword matching with perfect precision - run
# `npm run eval:evidence-retrieval` to reproduce. Qwen3-Embedding-0.6B has no
# live free-tier route to test against as of this writing.
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_API_KEY=local
LOCAL_EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
LOCAL_EMBEDDING_TIMEOUT_MS=12000
LOCAL_EMBEDDING_PROMOTE_THRESHOLD=0.60
LOCAL_EMBEDDING_ENRICH_THRESHOLD=0.50

PORT=10000
