# DraftApply Render proxy
# Copy to `.env` for local proxy development. Do not commit real secrets.

TOKEN_SECRET=replace-with-a-long-random-string

# Hosted primary path. Recommended for production final answers/CV generation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hosted fallback path. Used when Groq is busy/rate-limited and a fallback is allowed.
OPENROUTER_API_KEY=
OPENROUTER_MAX_FALLBACK_MODELS=6
OPENROUTER_TAILOR_FALLBACK=true
OPENROUTER_SITE_URL=https://draftapply.com
OPENROUTER_APP_NAME=DraftApply

# Optional lightweight model router.
# Point this at an OpenAI-compatible inference server such as vLLM, LM Studio,
# Ollama's OpenAI-compatible endpoint, or a managed endpoint.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Keep false at first: local Qwen is used for lower-risk extraction/enrichment
# steps, while final user-visible generation stays on hosted Groq/OpenRouter.
LOCAL_LLM_PREFER_FOR_GENERATION=false

# Optional future evidence retrieval/reranking endpoint. This is advertised in
# health checks but deterministic matching remains active until the embedding
# workflow is deliberately enabled in code.
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_API_KEY=local
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_TIMEOUT_MS=12000
LOCAL_EMBEDDING_PROMOTE_THRESHOLD=0.68
LOCAL_EMBEDDING_ENRICH_THRESHOLD=0.54

PORT=10000
